{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "next-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@vibesboard/web", "dev"],
      "port": 3000
    },
    {
      "name": "firebase-emulators",
      "runtimeExecutable": "firebase",
      "runtimeArgs": ["emulators:start"],
      "port": 4000
    },
    {
      "name": "firebase-functions",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/functions", "run", "serve"],
      "port": 5001
    }
  ]
}
