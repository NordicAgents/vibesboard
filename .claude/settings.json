{
  "permissions": {
    "allow": [
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:raw.githubusercontent.com)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CLAUDE_PLUGIN_ROOT=\"$(pwd)/.claude/plugins/superpowers\" \"$(pwd)/.claude/plugins/superpowers/hooks/session-start\"",
            "async": false
          }
        ]
      }
    ]
  }
}
