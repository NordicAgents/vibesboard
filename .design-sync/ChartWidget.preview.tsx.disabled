import { ChartWidget } from '@vibesboard/web'
import type { ChartConfig } from '@vibesboard/web'

const wrap: React.CSSProperties = { padding: 16, maxWidth: 520 }

const conversationsPerDay: ChartConfig = {
  type: 'bar',
  title: 'Conversations per day',
  labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
  datasets: [
    {
      label: 'WhatsApp',
      data: [142, 168, 155, 190, 210, 98, 76],
    },
    {
      label: 'Instagram',
      data: [54, 61, 72, 68, 88, 40, 33],
    },
  ],
}

const resolutionTrend: ChartConfig = {
  type: 'line',
  title: 'Resolved without handoff (%)',
  labels: ['Wk 1', 'Wk 2', 'Wk 3', 'Wk 4'],
  datasets: [
    {
      label: 'Resolution rate',
      data: [88, 91, 94, 96],
    },
  ],
}

export function ConversationsPerDay() {
  return (
    <div style={wrap}>
      <ChartWidget config={conversationsPerDay} />
    </div>
  )
}

export function ResolutionTrend() {
  return (
    <div style={wrap}>
      <ChartWidget config={resolutionTrend} />
    </div>
  )
}
