## Copy to .env and replace the placeholders. Generate secrets with:
##   openssl rand -hex 32
##
## Note on file layout: the Next.js app reads apps/web/.env.local (next dev's
## cwd is apps/web). The root .env / .env.local files reach root-level scripts
## (db:migrate, db:seed, scripts/*) and the E2E harness.

## ─── Platform LLM fallback ──────────────────────────────────────────
## Used only when a workspace has no matching provider configured in
## Settings → LLM Providers. Tenant provider keys live encrypted in the
## database — never put them here.
OPENAI_API_KEY=XXXXXXXX
OPENAI_MODEL=gpt-5.4-nano
# Optional: OpenAI-compatible gateway/proxy (also used by the local E2E mock).
# Caveat: @ai-sdk/openai@4 calls /responses, which most third-party
# OpenAI-compatible gateways do not implement. Gateways that only serve
# /chat/completions and /embeddings cannot back the chat fallback — configure
# such providers per workspace in Settings → LLM Providers instead.
# OPENAI_BASE_URL=https://api.openai.com/v1
# Optional: override the vision-capable model (defaults to gpt-5.4-nano)
# OPENAI_VISION_MODEL=gpt-5.4-nano
# Optional: override the model used by the agent-creation assistant
# OPENAI_AGENT_CREATOR_MODEL=gpt-5.4-nano
# Optional: override the embeddings model (defaults to text-embedding-3-small).
# Stored vectors must be 384, 768, 1024, or 1536 dimensions.
# OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

## ─── Application and auth ───────────────────────────────────────────
## Canonical app URL. Also the Better Auth callback base — a mismatch with the
## port the app is served on breaks sign-in.
NEXT_PUBLIC_APP_URL=https://your-production-domain.example

## Google sign-in is enabled only when BOTH values are set; leave unset to
## disable it.
AUTH_GOOGLE_ID=XXXXXXXX
AUTH_GOOGLE_SECRET=XXXXXXXX

## Better Auth (server-side session signing) — required in production
BETTER_AUTH_SECRET=your-better-auth-secret

## Access-gated public agents — hashes access passwords, signs access cookies
ACCESS_GATE_SECRET=your-access-gate-secret

## Encrypts tenant LLM, OAuth, and channel credentials at rest.
## Changing this makes every previously stored credential undecryptable.
ENCRYPTION_KEY=your-encryption-key

## Authenticates scheduled and background endpoints
CRON_SECRET=your-cron-secret

## ─── Webhooks and messaging channels ────────────────────────────────
## WhatsApp and Instagram accounts are configured per workspace and stored in
## the database; only the webhook verification secrets belong in the env.
VERIFY_TOKEN=your-webhook-secret-token
WHATSAPP_INBOX_VERIFY_TOKEN=your-whatsapp-inbox-verify-token
INSTAGRAM_INBOX_VERIFY_TOKEN=your-instagram-inbox-verify-token

## Meta app secret (webhook signature verification)
META_APP_SECRET=your-meta-app-secret

## Meta app identifiers used by the inbox onboarding UI
# NEXT_PUBLIC_META_APP_ID=your-meta-app-id
# NEXT_PUBLIC_FB_LOGIN_CONFIG_ID=your-facebook-login-config-id

## ─── Integrations ───────────────────────────────────────────────────
## Google Calendar and Google Sheets OAuth.
## Sheets falls back to the Calendar credentials unless its own pair is set.
## Redirect URIs are derived from NEXT_PUBLIC_APP_URL — do not set them here.
GOOGLE_CALENDAR_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=your-client-secret
# GOOGLE_SHEETS_CLIENT_ID=your-sheets-client-id.apps.googleusercontent.com
# GOOGLE_SHEETS_CLIENT_SECRET=your-sheets-client-secret

## Google Cross-Account Protection (RISC) — used by scripts/register-risc.ts,
## which reads only this value and NEXT_PUBLIC_APP_URL.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

## Resend (email verification, password reset, magic links, notifications).
## Without RESEND_API_KEY these URLs are printed to the server console.
# RESEND_API_KEY=re_xxxxxxxx
# NOTIFICATION_EMAIL_FROM=VibeAgent <notifications@yourdomain.com>

## ─── Postgres ───────────────────────────────────────────────────────
## App role — subject to RLS, used by the Next.js app and workers
DATABASE_URL=postgres://vibesboard_app:vibesboard_app@localhost:5432/vibesboard_dev
## Migrate role — BYPASSRLS, used by drizzle-kit and admin scripts ONLY
DATABASE_MIGRATE_URL=postgres://vibesboard_migrate:vibesboard_migrate@localhost:5432/vibesboard_dev
# Optional application connection-pool size (defaults to 10)
# DATABASE_POOL_MAX=10

## ─── S3-compatible storage ──────────────────────────────────────────
## MinIO for dev; in prod set to your S3/R2/B2/etc. endpoint
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vibesboard-files
S3_ACCESS_KEY_ID=vibesboard
S3_SECRET_ACCESS_KEY=vibesboard
## true for MinIO; false for AWS S3 / Cloudflare R2 / etc. (virtual-hosted style)
S3_FORCE_PATH_STYLE=true

## ─── Manual GCP deploy scripts (optional) ───────────────────────────
## Read only by deploy-cloud-run.sh and scripts/setup-secrets.sh — not by the
## app. Required when running those scripts; harmless to leave unset otherwise.
# GCP_PROJECT_ID=my-gcp-project
# GCP_REGION=us-central1
## Cloud Run service name (defaults to "vibeagent")
# CLOUD_RUN_SERVICE=vibeagent
## Cloud Scheduler region — set when GCP_REGION has no Cloud Scheduler support
# SCHEDULER_REGION=us-central1

## ─── Build-time only ────────────────────────────────────────────────
## NOT read by application code. Retained because ci-build.yml and
## deploy-cloudrun.yml still pass it as a build arg. It does not enable or
## disable Google sign-in — AUTH_GOOGLE_ID / AUTH_GOOGLE_SECRET do that.
NEXT_PUBLIC_AUTH_GOOGLE=false
