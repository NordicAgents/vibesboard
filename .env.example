## You must first activate a Billing Account here: https://platform.openai.com/account/billing/overview
## Then get your OpenAI API Key here: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=XXXXXXXX
OPENAI_MODEL=gpt-5.4-nano
# Optional: override the vision-capable model (defaults to gpt-5.4-nano)
# OPENAI_VISION_MODEL=gpt-5.4-nano
# Optional: override the embeddings model (defaults to text-embedding-3-small)
# OPENAI_EMBEDDINGS_MODEL=text-embedding-3-small

# Optional: Canonical site URL for production (used as a fallback
# when running behind proxies/CDNs to build absolute URLs)
NEXT_PUBLIC_APP_URL=https://your-production-domain.example

## GitHub OAuth — set first value to "false" if you choose not to use GitHub
NEXT_PUBLIC_AUTH_GITHUB=false
AUTH_GITHUB_ID=XXXXXXXX
AUTH_GITHUB_SECRET=XXXXXXXX

## Google OAuth — set first value to "false" if you choose not to use Google
NEXT_PUBLIC_AUTH_GOOGLE=false
AUTH_GOOGLE_ID=XXXXXXXX
AUTH_GOOGLE_SECRET=XXXXXXXX

## Webhook Configuration
## Token used for webhook verification (both GET and POST)
## Generate a random string: openssl rand -hex 32
VERIFY_TOKEN=your-webhook-secret-token

## Access-gated public agents
## Used to hash access passwords and sign access cookies
## Generate with: openssl rand -hex 32
ACCESS_GATE_SECRET=your-access-gate-secret

## WhatsApp Configuration
## Get these from your Facebook App Dashboard > WhatsApp Business
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_INBOX_VERIFY_TOKEN=your-whatsapp-inbox-verify-token
INSTAGRAM_INBOX_VERIFY_TOKEN=your-instagram-inbox-verify-token

## Meta App Secret (for webhook signature verification)
META_APP_SECRET=your-meta-app-secret

## Encryption key for WhatsApp token storage
## Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-encryption-key

## Cron job secret — used to authenticate scheduled queue processing
## Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret

## Firebase client config (NEXT_PUBLIC_* are embedded in the client bundle)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

## Firebase Admin SDK service account (JSON string)
## Download from Firebase Console > Project Settings > Service Accounts
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

## Google Cross-Account Protection (RISC)
## Web client ID from Firebase Console > Authentication > Sign-in method > Google
## Required for verifying Security Event Token audience
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

## Resend (email notifications)
## Get your API key from https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxx
# NOTIFICATION_EMAIL_FROM=VibeAgent <notifications@yourdomain.com>

## Stripe (payments & billing)
## Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
## Webhook signing secret from Stripe Dashboard > Webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxx
## Stripe Price IDs — created via scripts/stripe-setup.ts
STRIPE_PRICE_PRO_BASE=price_xxx
STRIPE_PRICE_PRO_OVERAGE=price_xxx
STRIPE_PRICE_TEAM_BASE=price_xxx
STRIPE_PRICE_TEAM_OVERAGE=price_xxx

## Postgres (self-host data plane)
## App role — subject to RLS, used by the Next.js app and workers
DATABASE_URL=postgres://vibesboard_app:vibesboard_app@localhost:5432/vibesboard_dev
## Migrate role — BYPASSRLS, used by drizzle-kit and admin scripts ONLY
DATABASE_MIGRATE_URL=postgres://vibesboard_migrate:vibesboard_migrate@localhost:5432/vibesboard_dev

## S3-compatible storage (self-host)
## MinIO for dev; in prod set to your S3/R2/B2/etc. endpoint
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=vibesboard-files
S3_ACCESS_KEY_ID=vibesboard
S3_SECRET_ACCESS_KEY=vibesboard
## true for MinIO; false for AWS S3 / Cloudflare R2 / etc. (virtual-hosted style)
S3_FORCE_PATH_STYLE=true
