import { NextResponse } from 'next/server'
import { getAllPendingFiles, processBatch } from '@/lib/agent/file-processor'

export const runtime = 'nodejs'
export const maxDuration = 300 // 5 minutes

/**
 * Cron job: Process pending files in the queue
 *
 * This endpoint should be called by Vercel Cron or external scheduler
 * every 5-10 minutes to process uploaded files automatically.
 *
 * Security: Protect this endpoint with CRON_SECRET environment variable
 */
export async function GET(req: Request) {
  // Verify cron secret
  const authHeader = req.headers.get('authorization')
  const cronSecret = process.env.CRON_SECRET

  if (!cronSecret) {
    console.warn('[Cron] CRON_SECRET not configured - skipping auth check')
  } else if (!authHeader || authHeader !== `Bearer ${cronSecret}`) {
    return new NextResponse('Unauthorized', { status: 401 })
  }

  try {
    console.log('[Cron] Starting file queue processing...')

    // Get pending files (limit 50 per run)
    const pendingFiles = await getAllPendingFiles(50)

    if (pendingFiles.length === 0) {
      console.log('[Cron] No pending files to process')
      return NextResponse.json({
        success: true,
        processed: 0,
        message: 'No pending files'
      })
    }

    console.log(`[Cron] Found ${pendingFiles.length} pending files`)

    // Process in batches of 5 concurrent
    const results = await processBatch(pendingFiles, 5)

    const successCount = results.filter(r => r.success).length
    const failedCount = results.filter(r => !r.success).length
    const totalChunks = results.reduce((sum, r) => sum + r.chunksCreated, 0)

    console.log(
      `[Cron] Completed: ${successCount} success, ${failedCount} failed, ${totalChunks} chunks created`
    )

    return NextResponse.json({
      success: true,
      processed: pendingFiles.length,
      successCount,
      failedCount,
      totalChunks,
      results: results.map(r => ({
        fileId: r.fileId,
        success: r.success,
        chunksCreated: r.chunksCreated,
        error: r.error
      }))
    })
  } catch (error) {
    const errorMessage = error instanceof Error ? error.message : String(error)
    console.error('[Cron] File queue processing failed:', errorMessage)

    return NextResponse.json(
      {
        success: false,
        error: errorMessage
      },
      { status: 500 }
    )
  }
}

/**
 * Also allow POST for manual triggering
 */
export async function POST(req: Request) {
  return GET(req)
}
