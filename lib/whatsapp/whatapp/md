  1. Find Active Connection

  // lib/whatsapp/connections.ts

  export async function findActiveConnection(
    phoneNumber: string
  ): Promise<WhatsAppAgentConnection | null> {
    const normalized = normalizePhoneNumber(phoneNumber);

    const { data, error } = await supabase
      .from('whatsapp_agent_connections')
      .select('*, vibe_agents(*)')
      .eq('phone_number_normalized', normalized)
      .eq('status', 'active')
      .maybeSingle();

    if (error) {
      console.error('Error finding connection:', error);
      return null;
    }

    return data;
  }

  function normalizePhoneNumber(phone: string): string {
    // Remove all non-digits
    return phone.replace(/\D/g, '');
  }

  2. Find Active Conversation

  export async function findActiveConversation(
    connectionId: string
  ): Promise<Conversation | null> {
    const { data } = await supabase
      .from('vibe_agent_conversations')
      .select('*')
      .eq('whatsapp_connection_id', connectionId)
      .is('closed_at', null)
      .order('created_at', { ascending: false })
      .limit(1)
      .maybeSingle();

    return data;
  }

  3. Format for WhatsApp

  export function formatForWhatsApp({
    text,
    suggestions,
    agent,
    isComplete
  }: FormatOptions): BotResponse {
    // No suggestions if completed
    if (isComplete || !suggestions || suggestions.length === 0) {
      return { type: 'text', text };
    }

    // Check suggestion mode
    if (agent.quick_suggestions_mode === 'off') {
      return { type: 'text', text };
    }

    // Use buttons if 3 or fewer suggestions
    if (suggestions.length <= 3) {
      return {
        type: 'buttons',
        text,
        buttons: suggestions.slice(0, 3)
      };
    }

    // Use list for 4-10 suggestions
    return {
      type: 'list',
      text,
      options: suggestions.slice(0, 10).map((s, i) => ({
        id: String(i + 1),
        title: s.substring(0, 24),
        description: ''
      }))
    };
  }

