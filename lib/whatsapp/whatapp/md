  Reset Connection

  export async function resetConnection(connectionId: string) {
    // Close all active conversations
    await supabase
      .from('vibe_agent_conversations')
      .update({ closed_at: new Date() })
      .eq('whatsapp_connection_id', connectionId)
      .is('closed_at', null);

    // Reset connection stats
    await supabase
      .from('whatsapp_agent_connections')
      .update({
        total_conversations: 0,
        last_message_received_at: null,
        updated_at: new Date()
      })
      .eq('id', connectionId);
  }

