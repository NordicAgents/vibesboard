  1. Connect Phone Number

  POST /api/agents/[agentId]/whatsapp/connections

  Request Body:
  {
    phoneNumber: "+919400293288",
    customIntroMessage?: string,
    sendIntroImmediately: boolean,
    expiresAt?: Date
  }

  Response:
  {
    connection: {
      id: "conn-uuid",
      agentId: "agent-uuid",
      phoneNumber: "+919400293288",
      status: "pending",
      introMessageSentAt: null,
      createdAt: "2026-02-09T00:00:00Z"
    },
    introMessageQueued: true
  }

  Errors:
  - 400: Invalid phone number format
  - 409: Phone already connected to another agent
  - 403: Unauthorized (not agent owner)

