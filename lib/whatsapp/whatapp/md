        // Could send: "No agent connected to this number"
        return NextResponse.json({ success: true }, { status: 200 });
      }

      console.log(`🎯 Routed to agent: ${connection.agent_id}`);

      // 2. EXTRACT MESSAGE TEXT
      let messageText = extractMessageText(message);

      // 3. FIND OR CREATE CONVERSATION
      let conversation = await findActiveConversation(connection.id);

      if (!conversation) {
        conversation = await createConversation({
          agent_id: connection.agent_id,
          whatsapp_connection_id: connection.id,
          whatsapp_phone_number: senderPhone,
          channel: 'whatsapp',
          external_id: senderPhone,
          messages: []
        });

        // Increment connection counter
        await incrementConversationCount(connection.id);
      }

      // 4. LOAD AGENT CONFIG
      const agent = await loadAgent(connection.agent_id);

      // 5. APPEND USER MESSAGE
      const userMessage = {
        id: nanoid(),
        role: 'user' as const,
        content: messageText
      };

      conversation.messages.push(userMessage);

      // 6. CALL AGENT RUNTIME
      const response = await callAgentRuntime({
        agent,
        messages: conversation.messages,
        conversationId: conversation.id
      });

      // 7. PARSE RESPONSE
      const {
        cleanText,
        suggestions,
        isComplete,
        completionReason
      } = parseAgentResponse(response);

      // 8. FORMAT FOR WHATSAPP
      const whatsappMessage = formatForWhatsApp({
        text: cleanText,
        suggestions,
        agent,
        isComplete
      });

      // 9. SEND RESPONSE
      const sentMessage = await sendWhatsAppMessage({
        to: senderPhone,
        response: whatsappMessage,
        phoneNumberId,
        accessToken
      });

      // 10. STORE ASSISTANT MESSAGE
      conversation.messages.push({
        id: nanoid(),
        role: 'assistant',
        content: cleanText
      });

      await updateConversation(conversation.id, {
        messages: conversation.messages,
        closed_at: isComplete ? new Date() : null
      });

      // 11. UPDATE CONNECTION
      await updateConnection(connection.id, {
        last_message_received_at: new Date()
      });

      console.log(`✅ Response sent via agent ${agent.name}`);

      return NextResponse.json({ success: true }, { status: 200 });

    } catch (error) {
      console.error("❌ Error:", error);
      return NextResponse.json({ success: true }, { status: 200 });
    }
  }

