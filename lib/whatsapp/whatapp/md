  // lib/whatsapp/intro-message.ts

  export function buildIntroMessage(agent: Agent, customMessage?: string):
   string {
    if (customMessage) {
      return customMessage;
    }

    const greeting = agent.greeting_text || "Hi! How can I help you 
  today?";

    const purpose = agent.mode === 'collector'
      ? "I'd love to collect your feedback"
      : "I'm here to answer your questions";

    return `👋 Hi! I'm **${agent.name}**.

  ${greeting}

  ${purpose}. Feel free to message me anytime!`;
  }

  export function buildIntroButtons(agent: Agent): WhatsAppButton[] {
    if (agent.mode === 'collector') {
      return [
        { id: "start", title: "Get Started" },
        { id: "learn_more", title: "Learn More" }
      ];
    }

    return [
      { id: "ask_question", title: "Ask Question" },
      { id: "learn_more", title: "Learn More" }
    ];
  }

  Sending Logic:

  // When connection is created
  async function sendIntroductionMessage(
    connection: WhatsAppAgentConnection,
    agent: Agent
  ) {
    const message = buildIntroMessage(agent,
  connection.customIntroMessage);
    const buttons = buildIntroButtons(agent);

    try {
      const result = await sendWhatsAppMessage({
        to: connection.phoneNumber,
        response: {
          type: "buttons",
          text: message,
          buttons: buttons.map(b => b.title)
        },
        phoneNumberId: process.env.WHATSAPP_PHONE_NUMBER_ID!,
        accessToken: process.env.WHATSAPP_ACCESS_TOKEN!
      });

      // Update connection
      await updateConnection(connection.id, {
        introMessageSentAt: new Date(),
        introMessageId: result.messages[0].id,
        status: 'active',
        connectedAt: new Date()
      });

      console.log(`✅ Intro message sent to ${connection.phoneNumber}`);
    } catch (error) {
      console.error(`❌ Failed to send intro to 
  ${connection.phoneNumber}:`, error);

      // Mark connection as failed
      await updateConnection(connection.id, {
        status: 'pending',
        // Could add error_message field to store reason
      });
    }
  }

