{
  "name": "vibeagent-monorepo",
  "version": "0.0.2",
  "private": true,
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "dev": "pnpm --filter @vibesboard/web dev",
    "build": "pnpm --filter @vibesboard/web build",
    "start": "pnpm --filter @vibesboard/web start",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "preview": "pnpm --filter @vibesboard/web preview",
    "type-check": "pnpm -r type-check",
    "test": "pnpm -r --if-present test",
    "format:write": "pnpm --filter @vibesboard/web format:write",
    "format:check": "pnpm --filter @vibesboard/web format:check",
    "build:functions": "cd apps/functions && npm run build",
    "db:up": "docker compose -f docker-compose.dev.yml up -d postgres adminer",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:reset": "docker compose -f docker-compose.dev.yml down -v && pnpm db:up && sleep 2 && pnpm db:migrate && pnpm db:seed",
    "db:migrate": "pnpm --filter @vibesboard/adapter-postgres db:migrate",
    "db:generate": "pnpm --filter @vibesboard/adapter-postgres db:generate",
    "db:studio": "pnpm --filter @vibesboard/adapter-postgres exec drizzle-kit studio",
    "db:seed": "pnpm --filter @vibesboard/adapter-postgres exec node --experimental-strip-types src/seed.ts",
    "db:setup": "pnpm db:up && sleep 3 && pnpm db:migrate && pnpm db:seed"
  },
  "overrides": {
    "glob": "^10.5.0",
    "minimatch": "^9.0.7",
    "seroval": "^1.4.1",
    "underscore": "^1.13.8",
    "fast-xml-parser": ">=5.5.6",
    "fast-xml-builder": ">=1.1.7",
    "protobufjs": ">=7.5.6",
    "node-forge": ">=1.4.0",
    "@xmldom/xmldom": ">=0.8.12"
  },
  "pnpm": {
    "overrides": {
      "glob": ">=10.5.0",
      "minimatch": ">=9.0.7",
      "seroval": ">=1.4.1",
      "underscore": ">=1.13.8",
      "fast-xml-parser": ">=5.5.6",
      "fast-xml-builder": ">=1.1.7",
      "protobufjs": ">=7.5.6",
      "node-forge": ">=1.4.0",
      "@xmldom/xmldom": ">=0.8.12"
    }
  }
}
