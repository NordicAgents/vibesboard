{
  "name": "vibeagent-monorepo",
  "version": "0.0.2",
  "private": true,
  "workspaces": ["apps/web", "packages/*"],
  "packageManager": "bun@1.2.18",
  "scripts": {
    "dev": "bun run --filter @vibesboard/web dev",
    "build": "bun run --filter @vibesboard/web build",
    "start": "bun run --filter @vibesboard/web start",
    "lint": "bun run --filter '*' lint",
    "lint:fix": "bun run --filter '*' lint:fix",
    "preview": "bun run --filter @vibesboard/web preview",
    "type-check": "bun run --filter '*' type-check",
    "test": "bun run --filter '*' --if-present test",
    "format:write": "bun run --filter @vibesboard/web format:write",
    "format:check": "bun run --filter @vibesboard/web format:check",
    "db:up": "docker compose -f docker-compose.dev.yml up -d postgres adminer minio minio-init",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "db:reset": "docker compose -f docker-compose.dev.yml down -v && bun run db:up && sleep 2 && bun run db:migrate && bun run db:seed",
    "db:migrate": "bun run --filter @vibesboard/adapter-postgres db:migrate",
    "db:generate": "bun run --filter @vibesboard/adapter-postgres db:generate",
    "db:studio": "bun run --filter @vibesboard/adapter-postgres db:studio",
    "db:seed": "bun run --filter @vibesboard/adapter-postgres db:seed",
    "db:setup": "bun run db:up && sleep 3 && bun run db:migrate && bun run db:seed",
    "minio:console": "open http://localhost:9001"
  },
  "overrides": {
    "eslint-plugin-react-hooks": "7.0.1",
    "glob": "^10.5.0",
    "minimatch": "^9.0.7",
    "seroval": "^1.4.1",
    "underscore": "^1.13.8",
    "fast-xml-parser": ">=5.5.6",
    "fast-xml-builder": ">=1.1.7",
    "protobufjs": ">=7.5.6",
    "node-forge": ">=1.4.0",
    "@xmldom/xmldom": ">=0.8.12",
    "tmp": ">=0.2.6"
  }
}
